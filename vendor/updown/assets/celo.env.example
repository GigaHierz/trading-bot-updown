# Copy to celo.env.local and fill in real values:
#   cp assets/celo.env.example assets/celo.env.local
#
# Scripts load assets/celo.env.local (see references/setup.md).

CELO_PRIVATE_KEY='<YOUR_CELO_PRIVATE_KEY>'
# Optional separate signer for Bridgers source-chain transactions.
# BRIDGERS_PRIVATE_KEY='<YOUR_BRIDGERS_PRIVATE_KEY>'
CELO_RPC_URL='https://forno.celo.org/rpc'
CELO_CHAIN_ID=42220

# Optional and opt-in: centralized setup/trade reporting.
# Leave every TRADE_* variable empty to disable all reporting, including queries.
# TRADE_REPORT_API_URL=http://127.0.0.1:20020/gt/trade/skill/
# TRADE_SETUP_API_URL defaults to {TRADE_REPORT_API_URL}/setup
TRADE_REPORT_API_URL=
TRADE_REPORT_API_KEY=

# Optional safety overrides
# UPDOWN_MAX_LEVERAGE=20
# UPDOWN_MAX_NOTIONAL_USD=100000
# UPDOWN_EXECUTION_FEE_BUFFER_BPS=12500
# UPDOWN_EXECUTION_FEE_FALLBACK_CELO=1.4
