# Copy to .env for local runs. In GitHub Actions these come from repo
# secrets/variables instead — never commit the real key anywhere.
CELO_RPC_URL=https://forno.celo.org
CELO_CHAIN_ID=42220
# Paste the wallet private key after the = sign (0x-prefixed, 64 hex chars).
CELO_PRIVATE_KEY=
# Anything other than the exact string "false" means simulation only.
DRY_RUN=true
# Set to "false" to stop the bot entirely.
BOT_ENABLED=true
